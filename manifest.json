{
  "manifest_version": 3,
  "name": "Khớp tổng tiền hóa đơn - MVP",
  "version": "1.19.41",
  "description": "Lập phương án stock-first, lưu tuần tự bằng API chính thức và chỉ ghi sao kê/tồn kho sau khi đọc lại phiếu khớp hoàn toàn. Phát hành hóa đơn điện tử hàng loạt sau khi người dùng xác nhận và ghi lại mặt hàng để xuất file hạch toán.",
  "permissions": ["storage", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://banhang.thuanvietsoft.com/*",
        "https://banhang.thuanvietsoft.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://banhang.thuanvietsoft.com/*",
        "https://banhang.thuanvietsoft.com/*"
      ],
      "js": ["web-catalog.js", "web-catalog-parislinhdam.js", "inventory-data.js", "mapping-parislinhdam.js", "xlsx-reader.js", "xlsx-writer.js", "mapping-store.js", "mapping-engine.js", "shared-warehouse.js", "solver.js", "stock-state.js", "issued-invoices.js", "api-template.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
